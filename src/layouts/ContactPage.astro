---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import ContactForm from '@components/ContactForm.astro'
import { type Locale } from '@i18n/config'
import { useTranslations } from '@i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const email = 'info@rahlwes.eu'
---

<DefaultLayout title={t('contact.title')} description={t('contact.intro')}>
  <PageHeader title={t('contact.title')} showBreadcrumbs={false} />
  <section class="my-16">
    <div class="container contact-grid">
      <div class="space-content">
        <p class="lead">{t('contact.intro')}</p>
        <ContactForm locale={locale} />
      </div>
      <aside class="direct">
        <p>
          <a href={`mailto:${email}`}>{email}</a>
        </p>
        <p class="hint">{t('form.required')}: *</p>
      </aside>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .contact-grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;

    @media (min-width: 60rem) {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }

  .lead {
    max-inline-size: var(--font-measure);
    font-size: var(--font-size-1);
  }

  .direct {
    border-inline-start: 3px solid var(--color-accent-400);
    padding-inline-start: var(--space-s);
    block-size: fit-content;
  }

  .hint {
    color: var(--color-neutral-700);
    font-size: var(--font-size--1);
  }
</style>
