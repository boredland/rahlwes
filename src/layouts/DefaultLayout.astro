---
import '../styles/tailwind.css'
import '../assets/scss/index.scss'
import themeConfig from '@theme-config'
import { SEO } from 'astro-seo'
import { Font } from 'astro:assets'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import { ClientRouter } from 'astro:transitions'
import { currentLocale, htmlLang, locales, localizePath, stripLocale } from '@i18n/config'
import { useTranslations } from '@i18n/ui'
import { personSchema, websiteSchema } from '@i18n/schema'
import type { ImageMetadata } from 'astro'

interface Props {
  title?: string
  description?: string
  url?: string
  image?: ImageMetadata | string | null
  author?: string
  type?: 'website' | 'article'
  useTitleTemplate?: boolean
  /** Page-level JSON-LD, merged into the site-wide graph. */
  schema?: Record<string, unknown>[]
}

const locale = currentLocale(Astro.currentLocale)
const t = useTranslations(locale)

const {
  title = t('site.title'),
  description = t('site.description'),
  url = Astro.url.href,
  image = themeConfig.seo.image ?? null,
  author = themeConfig.seo.author ?? '',
  type = 'website',
  useTitleTemplate = true,
  schema,
} = Astro.props

const basePath = stripLocale(Astro.url.pathname)

/**
 * The staging domain serves the same content as rahlwes.eu. Letting search engines
 * index it would split ranking signals between two identical sites, so everything
 * outside production is explicitly excluded.
 */
const isProduction = Astro.site?.hostname === 'rahlwes.eu'

// One @graph per page: the Person and WebSite nodes are shared by @id, so page
// schema can reference them instead of repeating the author on every entry.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [personSchema(locale, Astro.site), websiteSchema(locale, Astro.site), ...(schema ?? [])],
}

const imagePath = image ? (typeof image === 'string' ? image : image.src) : '/social-preview-image.png'
const imageUrl = new URL(imagePath, Astro.site).href
---

<html lang={htmlLang[locale]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* No preload: it would fetch all eight variants (76 kB) including italics, which no page needs for first paint. */}
    <Font cssVariable="--font-pt-sans" />

    {
      locales.map((code) => (
        <link rel="alternate" hreflang={htmlLang[code]} href={new URL(localizePath(basePath, code), Astro.site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(basePath, 'de'), Astro.site).href} />

    <style
      define:vars={{
        brandPrimary: themeConfig.colors.primary,
        brandSecondary: themeConfig.colors.secondary,
        brandNeutral: themeConfig.colors.neutral,
        brandAccent: themeConfig.colors.accent,
      }}
    >
      :global(:root) {
        --brand-primary: var(--brandPrimary);
        --brand-secondary: var(--brandSecondary);
        --brand-neutral: var(--brandNeutral);
        --brand-accent: var(--brandAccent);
      }
    </style>

    <SEO
      title={title}
      titleTemplate={useTitleTemplate ? `%s — ${themeConfig.name} — ${t('site.tagline')}` : undefined}
      titleDefault={t('site.title')}
      description={description}
      canonical={url}
      openGraph={{
        basic: { title, type, image: imageUrl, url },
        optional: { description, locale: htmlLang[locale] },
      }}
      twitter={{ card: 'summary_large_image', title, description, image: imageUrl }}
      noindex={!isProduction}
      nofollow={!isProduction}
      extend={{ meta: [{ name: 'author', content: author }] }}
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <ClientRouter />
  </head>
  <body>
    <Header />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <style lang="scss" is:global>
      @use 'scss/base/mixins' as *;

      // sticky footer on low content pages
      html,
      body {
        height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        overflow-x: clip;

        main {
          flex: 1 0 auto;
        }

        footer {
          flex-shrink: 0;
        }
      }

      pre {
        border: 2px solid var(--link-color);
        border-radius: 0.35rem;
        padding: 1rem;
      }

      .card {
        a {
          @include text-decoration(transparent, var(--foreground-color), 4px, 2px);
        }
      }
    </style>
  </body>
</html>
