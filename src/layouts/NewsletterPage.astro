---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import NewsletterForm from '@components/NewsletterForm.astro'
import { type Locale } from '@i18n/config'
import { useTranslations } from '@i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

// Set by /api/newsletter/verify when a confirmation link is followed.
const status = Astro.url.searchParams.get('status')
---

<DefaultLayout title={t('newsletter.title')} description={t('newsletter.intro')}>
  <PageHeader title={t('newsletter.title')} showBreadcrumbs={false} />
  <section class="my-16">
    <div class="container space-content">
      {status === 'verified' && <p class="notice is-success">{t('newsletter.verified')}</p>}
      {status === 'invalid' && <p class="notice is-error">{t('newsletter.invalidToken')}</p>}

      <p class="lead">{t('newsletter.intro')}</p>
      <NewsletterForm locale={locale} />
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .lead {
    max-inline-size: var(--font-measure);
    font-size: var(--font-size-1);
  }

  .notice {
    border-inline-start: 3px solid currentcolor;
    padding-inline-start: var(--space-s);
    max-inline-size: var(--font-measure);
    font-weight: 700;

    &.is-success {
      color: var(--color-accent-600);
    }

    &.is-error {
      color: #b3261e;
    }
  }
</style>
