---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Link } from 'accessible-astro-components'
import { localizePath, type Locale } from '@i18n/config'
import { useTranslations } from '@i18n/ui'
import { getProjects } from '@i18n/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const projects = await getProjects(locale)
---

<DefaultLayout title={t('projects.title')}>
  <PageHeader title={t('projects.title')} showBreadcrumbs={false} />
  <section class="my-16">
    <div class="container">
      {projects.length === 0 && <p>{t('projects.empty')}</p>}
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => {
            const slug = project.id.split('/').slice(1).join('/')
            return (
              <article class="teaser">
                {project.data.coverImage && (
                  <img
                    src={project.data.coverImage}
                    alt={project.data.coverAlt}
                    width="600"
                    height="400"
                    loading="lazy"
                  />
                )}
                <p class="meta">{t(`projects.category.${project.data.category}`)}</p>
                <Heading level="h2" size="h5" class="mb-2">
                  <Link href={localizePath(`/projekte/${slug}`, locale)}>{project.data.title}</Link>
                </Heading>
                <p>{project.data.excerpt}</p>
              </article>
            )
          })
        }
      </div>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .teaser img {
    border-radius: var(--radius-m);
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
    aspect-ratio: 3 / 2;
  }

  .meta {
    margin-block-start: var(--space-2xs);
    color: var(--color-primary-400);
    font-size: var(--font-size--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
