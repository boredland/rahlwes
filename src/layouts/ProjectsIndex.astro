---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import ContentImage from '@components/ContentImage.astro'
import { Heading, Link } from 'accessible-astro-components'
import { localizePath, type Locale } from '@i18n/config'
import { useTranslations } from '@i18n/ui'
import { getProjects } from '@i18n/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const projects = await getProjects(locale)
---

<DefaultLayout title={t('projects.title')}>
  <PageHeader title={t('projects.title')} showBreadcrumbs={false} />
  <section class="my-16">
    <div class="container">
      {projects.length === 0 && <p>{t('projects.empty')}</p>}
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project, index) => {
            const slug = project.id.split('/').slice(1).join('/')
            return (
              <article class="teaser">
                <ContentImage
                  class="teaser-image"
                  src={project.data.coverImage}
                  alt={project.data.coverAlt}
                  widths={[300, 500, 700]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 90vw"
                  aspect="3 / 2"
                  loading={index < 3 ? 'eager' : 'lazy'}
                />
                <p class="meta">{t(`projects.category.${project.data.category}`)}</p>
                <Heading level="h2" size="h5" class="mb-2">
                  <Link href={localizePath(`/projekte/${slug}`, locale)}>{project.data.title}</Link>
                </Heading>
                <p>{project.data.excerpt}</p>
              </article>
            )
          })
        }
      </div>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .teaser :global(.teaser-image) {
    border-radius: var(--radius-m);
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
  }

  .meta {
    margin-block-start: var(--space-2xs);
    color: var(--link-color);
    font-size: var(--font-size--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
