---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import ContactCta from '@components/ContactCta.astro'
import PageHeader from '@components/PageHeader.astro'
import ContentImage from '@components/ContentImage.astro'
import { Heading, Link } from 'accessible-astro-components'
import { localizePath, type Locale } from '@i18n/config'
import { useTranslations } from '@i18n/ui'
import { getProjects } from '@i18n/content'
import { breadcrumbSchema } from '@i18n/schema'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const projects = await getProjects(locale)

// Grouped by category so the overview stays readable as the reference pages grow.
const categories = ['ausstellung', 'digital', 'material'] as const
const grouped = categories
  .map((category) => ({ category, entries: projects.filter((p) => p.data.category === category) }))
  .filter((group) => group.entries.length > 0)
---

<DefaultLayout
  title={t('projects.title')}
  description={t('projects.description')}
  schema={[
    breadcrumbSchema([
      { name: t('nav.home'), url: new URL(localizePath('/', locale), Astro.site).href },
      { name: t('projects.title'), url: Astro.url.href },
    ]),
  ]}
>
  <PageHeader title={t('projects.title')} subtitle={t('projects.description')} showBreadcrumbs={false} />
  <section class="my-16">
    <div class="container">
      {projects.length === 0 && <p>{t('projects.empty')}</p>}
      {
        grouped.map((group, groupIndex) => (
          <section class="category">
            <Heading level="h2" size="h4" class="mb-8">
              {t(`projects.category.${group.category}`)}
            </Heading>
            <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
              {group.entries.map((project, index) => {
                const slug = project.id.split('/').slice(1).join('/')
                return (
                  <article class="teaser">
                    <ContentImage
                      class="teaser-image"
                      src={project.data.coverImage}
                      alt={project.data.coverAlt}
                      widths={[300, 500, 700]}
                      sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 90vw"
                      aspect="3 / 2"
                      loading={groupIndex === 0 && index < 3 ? 'eager' : 'lazy'}
                    />
                    <Heading level="h3" size="h5" class="mt-4 mb-2">
                      <Link href={localizePath(`/projekte/${slug}`, locale)}>{project.data.title}</Link>
                    </Heading>
                    <p>{project.data.excerpt}</p>
                  </article>
                )
              })}
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <ContactCta locale={locale} heading={t('contact.title')} text={t('contact.intro')} />
</DefaultLayout>

<style lang="scss">
  .teaser :global(.teaser-image) {
    border-radius: var(--radius-m);
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
  }

  // Category eyebrow: -600 is the accent step that clears 4.5:1 on white, since
  // this is small text rather than a graphic element.
  .category + .category {
    margin-block-start: var(--space-2xl);
  }

  .meta {
    margin-block-start: var(--space-2xs);
    color: var(--color-accent-600);
    font-size: var(--font-size--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
