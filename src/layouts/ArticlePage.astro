---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import ContentImage from '@components/ContentImage.astro'
import ContactCta from '@components/ContactCta.astro'
import { htmlLang, localizePath, type Locale } from '@i18n/config'
import { articleSchema, breadcrumbSchema } from '@i18n/schema'
import { useTranslations } from '@i18n/ui'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

interface Props {
  locale: Locale
  entry: CollectionEntry<'journal'> | CollectionEntry<'projects'> | CollectionEntry<'pages'>
}

const { locale, entry } = Astro.props
const t = useTranslations(locale)
const { Content } = await render(entry)

const publishedAt = 'publishedAt' in entry.data ? entry.data.publishedAt : null
const coverImage = 'coverImage' in entry.data ? entry.data.coverImage : null
const coverAlt = 'coverAlt' in entry.data ? entry.data.coverAlt : ''
const excerpt = 'excerpt' in entry.data ? entry.data.excerpt : 'intro' in entry.data ? entry.data.intro : ''
const dateFormat = new Intl.DateTimeFormat(htmlLang[locale], { dateStyle: 'long' })

// On by default for pages, projects and journal entries; legal pages opt out.
const showContactCta = 'contactCta' in entry.data && entry.data.contactCta
const ctaHeading = ('contactCtaHeading' in entry.data && entry.data.contactCtaHeading) || t('contact.title')
const ctaText = ('contactCtaText' in entry.data && entry.data.contactCtaText) || t('contact.intro')

// Standalone pages sit directly under the homepage; only journal and project
// entries belong to a listing section.
const section =
  entry.collection === 'journal'
    ? { name: t('journal.title'), path: '/journal' }
    : entry.collection === 'projects'
      ? { name: t('projects.title'), path: '/projekte' }
      : null
---

<DefaultLayout
  title={entry.data.seo.title || entry.data.title}
  description={entry.data.seo.description || excerpt}
  type="article"
  useTitleTemplate={!entry.data.seo.title}
  schema={[
    articleSchema({
      kind: entry.collection === 'journal' ? 'BlogPosting' : 'WebPage',
      title: entry.data.title,
      description: entry.data.seo.description || excerpt,
      url: Astro.url.href,
      image: coverImage ? new URL(coverImage, Astro.site).href : null,
      published: publishedAt ?? undefined,
      locale,
    }),
    breadcrumbSchema([
      { name: t('nav.home'), url: new URL(localizePath('/', locale), Astro.site).href },
      ...(section ? [{ name: section.name, url: new URL(localizePath(section.path, locale), Astro.site).href }] : []),
      { name: entry.data.title, url: Astro.url.href },
    ]),
  ]}
>
  <PageHeader title={entry.data.title} subtitle={excerpt} showBreadcrumbs={false} />
  <article class="my-12">
    <div class="container">
      {
        publishedAt && (
          <p class="meta">
            {t('journal.published')}{' '}
            <time datetime={publishedAt.toISOString()}>{dateFormat.format(publishedAt)}</time>
          </p>
        )
      }
      <ContentImage
        class="cover"
        src={coverImage}
        alt={coverAlt}
        widths={[600, 900, 1200]}
        sizes="(min-width: 1024px) 70vw, 95vw"
        aspect="12 / 7"
        loading="eager"
      />
      <div class="prose space-content">
        <Content />
      </div>
    </div>

    {
      showContactCta && (
        <ContactCta locale={locale} heading={ctaHeading} text={ctaText} image="/uploads/museen-dialog.webp" imageAlt="" />
      )
    }
  </article>
</DefaultLayout>

<style lang="scss">
  .meta {
    margin-block-end: var(--space-s);
    color: var(--color-neutral-700);
    font-size: var(--font-size--1);
  }

  :global(.cover) {
    margin-block-end: var(--space-l);
    border-radius: var(--radius-l);
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
  }

  .prose {
    max-inline-size: var(--font-measure);
  }
</style>
