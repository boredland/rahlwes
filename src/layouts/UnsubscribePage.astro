---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { type Locale } from '@i18n/config'
import { useTranslations } from '@i18n/ui'
import { isToken } from '@newsletter/tokens'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

/**
 * A token in the URL means the reader followed the link in a mail. It still takes a
 * button press: mail scanners fetch every link, and a GET that deleted the row would
 * unsubscribe readers whose employer merely scanned the newsletter. One button is the
 * least confirmation that survives that, and needs no typing.
 */
const token = Astro.url.searchParams.get('token')
const done = Astro.url.searchParams.get('status') === 'done'
---

<DefaultLayout title={t('newsletter.unsubscribe')} description={t('newsletter.unsubscribeIntro')}>
  <PageHeader title={t('newsletter.unsubscribe')} />
  <section class="my-16">
    <div class="container space-content">
      {
        done ? (
          <p class="notice is-success">{t('newsletter.unsubscribeDone')}</p>
        ) : isToken(token) ? (
          <form class="unsubscribe-form" method="post" action="/api/newsletter/unsubscribe">
            <input type="hidden" name="token" value={token} />
            <input type="hidden" name="locale" value={locale} />
            <p class="lead">{t('newsletter.unsubscribeConfirm')}</p>
            <p class="actions">
              <button type="submit">{t('newsletter.unsubscribeSubmit')}</button>
            </p>
          </form>
        ) : (
          <>
            <p class="lead">{t('newsletter.unsubscribeIntro')}</p>
            <form class="unsubscribe-form" method="post" action="/api/newsletter/unsubscribe">
              <input type="hidden" name="locale" value={locale} />
              <p class="field">
                <label for="unsubscribe-email">{t('newsletter.email')}</label>
                <input id="unsubscribe-email" name="email" type="email" autocomplete="email" required maxlength="254" />
              </p>
              <p class="actions">
                <button type="submit">{t('newsletter.unsubscribeSubmit')}</button>
              </p>
            </form>
          </>
        )
      }
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .lead {
    max-inline-size: var(--font-measure);
    font-size: var(--font-size-1);
  }

  .notice {
    border-inline-start: 3px solid currentcolor;
    padding-inline-start: var(--space-s);
    max-inline-size: var(--font-measure);
    font-weight: 700;

    &.is-success {
      color: var(--color-accent-600);
    }
  }

  .unsubscribe-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-inline-size: 34rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin: 0;
  }

  label {
    font-size: var(--font-size--1);
    font-weight: 700;
  }

  input[type='email'] {
    border: 2px solid var(--border-color-subtle);
    border-radius: var(--radius-s);
    background-color: var(--background-color);
    padding: var(--space-2xs) var(--space-xs);
    color: var(--foreground-color);
    font-family: inherit;
    font-size: var(--font-size-0);

    &:focus-visible {
      outline: 3px dotted var(--outline-color);
      outline-offset: 2px;
      border-color: var(--link-color);
    }
  }

  .actions {
    margin: 0;
  }

  button[type='submit'] {
    border: 2px solid var(--color-accent-600);
    border-radius: var(--radius-s);
    background-color: var(--color-accent-600);
    padding: var(--space-2xs) var(--space-m);
    color: #fff;
    font-family: inherit;
    font-size: var(--font-size-0);
    font-weight: 700;
    cursor: pointer;

    &:where(:hover, :focus-visible) {
      background-color: transparent;
      color: var(--color-accent-600);
    }
  }
</style>
