---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import ContactCta from '@components/ContactCta.astro'
import PageHeader from '@components/PageHeader.astro'
import ContentImage from '@components/ContentImage.astro'
import { Heading, Link } from 'accessible-astro-components'
import { htmlLang, localizePath, type Locale } from '@i18n/config'
import { useTranslations } from '@i18n/ui'
import { getJournal } from '@i18n/content'
import { breadcrumbSchema } from '@i18n/schema'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const posts = await getJournal(locale)
const dateFormat = new Intl.DateTimeFormat(htmlLang[locale], { dateStyle: 'long' })
---

<DefaultLayout
  title={t('journal.title')}
  description={t('journal.description')}
  schema={[
    breadcrumbSchema([
      { name: t('nav.home'), url: new URL(localizePath('/', locale), Astro.site).href },
      { name: t('journal.title'), url: Astro.url.href },
    ]),
  ]}
>
  <PageHeader title={t('journal.title')} showBreadcrumbs={false} />
  <section class="my-16">
    <div class="container">
      {posts.length === 0 && <p>{t('journal.empty')}</p>}
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post, index) => {
            const slug = post.id.split('/').slice(1).join('/')
            return (
              <article class="teaser">
                <ContentImage
                  class="teaser-image"
                  src={post.data.coverImage}
                  alt={post.data.coverAlt}
                  widths={[300, 500, 700]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 90vw"
                  aspect="3 / 2"
                  loading={index < 3 ? 'eager' : 'lazy'}
                />
                <p class="meta">
                  {t('journal.published')}{' '}
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {dateFormat.format(post.data.publishedAt)}
                  </time>
                </p>
                <Heading level="h2" size="h5" class="mb-2">
                  <Link href={localizePath(`/journal/${slug}`, locale)}>{post.data.title}</Link>
                </Heading>
                <p>{post.data.excerpt}</p>
              </article>
            )
          })
        }
      </div>
    </div>
  </section>

  <ContactCta locale={locale} heading={t('contact.title')} text={t('contact.intro')} />
</DefaultLayout>

<style lang="scss">
  .teaser :global(.teaser-image) {
    border-radius: var(--radius-m);
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
  }

  .meta {
    margin-block-start: var(--space-2xs);
    color: var(--color-neutral-700);
    font-size: var(--font-size--1);
  }
</style>
