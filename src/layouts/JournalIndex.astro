---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import ContactCta from '@components/ContactCta.astro'
import ContentImage from '@components/ContentImage.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Image } from 'astro:assets'
import journalHero from '@assets/uploads/journal-hero.webp'
import { htmlLang, localizePath, type Locale } from '@i18n/config'
import { useTranslations } from '@i18n/ui'
import { getJournal } from '@i18n/content'
import { breadcrumbSchema } from '@i18n/schema'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const posts = await getJournal(locale)
const dateFormat = new Intl.DateTimeFormat(htmlLang[locale], { dateStyle: 'long' })
---

<DefaultLayout
  title={t('journal.title')}
  description={t('journal.description')}
  schema={[
    breadcrumbSchema([
      { name: t('nav.home'), url: new URL(localizePath('/', locale), Astro.site).href },
      { name: t('journal.title'), url: Astro.url.href },
    ]),
  ]}
>
  <section class="journal-hero">
    <Image
      src={journalHero}
      alt=""
      width={2500}
      height={1100}
      class="hero-bg"
      loading="eager"
    />
    <div class="hero-overlay">
      <h1>{t('journal.heroTitle') || 'Let\u2019s talk about history!'}</h1>
      <p class="hero-subtitle">{t('journal.title')}</p>
      {locale !== 'de' && (
        <a href={localizePath('/journal', 'de')} class="lang-btn">Deutsch</a>
      )}
      {locale === 'de' && (
        <a href={localizePath('/journal', 'en')} class="lang-btn">English</a>
      )}
    </div>
  </section>

  <section class="journal-intro">
    <div class="container">
      <p class="intro-text">{t('journal.intro')}</p>
    </div>
  </section>

  <section class="my-16">
    <div class="container">
      {posts.length === 0 && <p>{t('journal.empty')}</p>}
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post, index) => {
            const slug = post.id.split('/').slice(1).join('/')
            return (
              <article class="teaser">
                <ContentImage
                  class="teaser-image"
                  src={post.data.coverImage}
                  alt={post.data.coverAlt}
                  widths={[300, 500, 700]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 90vw"
                  aspect="3 / 2"
                  loading={index < 3 ? 'eager' : 'lazy'}
                />
                <p class="meta">
                  {t('journal.published')}{' '}
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {dateFormat.format(post.data.publishedAt)}
                  </time>
                </p>
                <Heading level="h2" size="h5" class="mb-2">
                  <Link href={localizePath(`/journal/${slug}`, locale)}>{post.data.title}</Link>
                </Heading>
                <p>{post.data.excerpt}</p>
              </article>
            )
          })
        }
      </div>
    </div>
  </section>

  <ContactCta locale={locale} heading={t('contact.title')} text={t('contact.intro')} />
</DefaultLayout>

<style lang="scss">
  .journal-hero {
    position: relative;
    overflow: hidden;
    margin-block: -1rem;
  }

  .hero-bg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
    aspect-ratio: 2500 / 1100;
    object-position: 65% 40%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-l);
    color: #fff;
    text-align: center;

    h1 {
      font-size: clamp(2rem, 5vw, 4rem);
      font-weight: 700;
      margin-block-end: var(--space-xs);
    }
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    opacity: 0.9;
    margin-block-end: var(--space-s);
  }

  .lang-btn {
    display: inline-block;
    padding: var(--space-2xs) var(--space-m);
    background: #fff;
    color: var(--color-neutral-800);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-s);

    &:hover {
      background: var(--color-neutral-100);
    }
  }

  .journal-intro {
    padding-block: var(--space-2xl);
  }

  .intro-text {
    max-inline-size: 42ch;
    margin-inline: auto;
    text-align: center;
    font-size: var(--font-size-1);
    color: var(--color-neutral-600);
    line-height: 1.7;
  }

  .teaser :global(.teaser-image) {
    border-radius: var(--radius-m);
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
  }

  .meta {
    margin-block-start: var(--space-2xs);
    color: var(--color-neutral-700);
    font-size: var(--font-size--1);
  }
</style>
