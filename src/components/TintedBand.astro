---
import ContentImage from '@components/ContentImage.astro'
import { Heading } from 'accessible-astro-components'

/**
 * A full-width illustrated band around a block of content, the shape the Squarespace
 * site used to break a long page into sections.
 *
 * It sits inside the article's reading column, so it has to break out of it. The
 * offset cannot be derived in CSS alone — `calc(50% - 50vw)` only lands correctly
 * when the parent is itself centred, and the prose column is not — so the escape is
 * done with a wrapper that spans the container and a negative inline margin measured
 * against that container's own padding.
 */
interface Props {
  heading?: string
  image?: string
  imageAlt?: string
}

const { heading, image, imageAlt = '' } = Astro.props
---

<aside class="tinted-band">
  {
    image && (
      <div class="backdrop" aria-hidden="true">
        <ContentImage src={image} alt={imageAlt} widths={[768, 1280, 1920]} sizes="100vw" loading="lazy" />
      </div>
    )
  }
  <div class="band-inner space-content">
    {heading && <Heading level="h2" size="h2" class="band-heading">{heading}</Heading>}
    <slot />
  </div>
</aside>

<style lang="scss">
  .tinted-band {
    position: relative;
    isolation: isolate;
    margin-block: var(--space-2xl);
    // Extra room at the bottom for the orange strip the artwork carries there.
    padding-block: var(--space-xl) clamp(4.5rem, 11vw, 9rem);
    background-color: var(--band-tint, #c3d0ec);
    color: var(--color-neutral-900);

    // Break out of the 70ch measure, but never past the container's own padding —
    // the gutter is what stops the band overflowing the viewport on small screens,
    // where the column already spans nearly the full width.
    margin-inline: calc(-1 * min(var(--space-l), var(--grid-gutter)));
    border-radius: var(--radius-m);
    overflow: hidden;

    @media (min-width: 48rem) {
      margin-inline: calc(-1 * min(var(--space-2xl), var(--grid-gutter)));
      border-radius: var(--radius-l);
    }
  }

  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .backdrop :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .band-inner {
    padding-inline: var(--space-l);

    @media (min-width: 48rem) {
      // The illustration puts figures against both edges, so the text sits in a
      // centred column clear of them rather than running the full width.
      margin-inline: auto;
      padding-inline: var(--space-2xl);
      max-inline-size: 34rem;
    }
  }

  .band-heading {
    text-align: center;
    text-wrap: balance;
  }

  // The artwork is drawn light, so the band keeps its own colours rather than
  // following the page into dark mode and stranding the illustration.
  :global(.darkmode) .tinted-band :global(p),
  :global(.darkmode) .tinted-band :global(blockquote),
  :global(.darkmode) .tinted-band :global(cite),
  :global(.darkmode) .tinted-band .band-heading {
    color: var(--color-neutral-900);
  }
</style>
