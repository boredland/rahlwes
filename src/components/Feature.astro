---
import { Heading } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import ContentImage from '@components/ContentImage.astro'

/**
 * Feature Component
 *
 * @description A component that displays a feature with an icon, title, and description
 */
interface Props {
  /**
   * The icon to display, used when no illustration is given.
   */
  icon: string
  /**
   * Her own illustration for this service. The Squarespace site used these rather
   * than icons, and they carry far more of the site's character.
   */
  image?: string | null
  imageAlt?: string
  /**
   * The title to display
   */
  title: string
  /**
   * The heading level for the feature title
   * @default 'h3'
   */
  level?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
}

const { icon = 'mdi:rocket', image, imageAlt = '', title = 'Title', level = 'h3' }: Props = Astro.props
---

<div class="feature flex flex-col gap-4">
  {
    image ? (
      <ContentImage
        class="feature-image"
        src={image}
        alt={imageAlt}
        widths={[240, 360, 480]}
        sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 40vw, 80vw"
      />
    ) : (
      <Icon aria-hidden="true" name={icon} />
    )
  }
  <div class="content">
    <Heading level={level} size="h6" class="mb-2">{title}</Heading>
    <p>
      <slot>Lorem ipsum dolor sit amet consectetur adipisicing elit. Hic, corporis.</slot>
    </p>
  </div>
</div>

<style lang="scss">
  @use 'scss/base/breakpoint' as *;

  .feature {
    position: relative;
    padding: var(--space-l);
    inline-size: calc(100% - var(--space-l));

    > * {
      position: relative;
      z-index: 2;
    }

    @include breakpoint(xl) {
      inline-size: 100%;
    }

    &::before,
    &::after {
      position: absolute;
      content: '';
    }

    &::before {
      z-index: 1;
      inset: 0;
      box-shadow: 0 0 0 6px var(--color-neutral-100);
      border: 3px solid var(--color-neutral-700);
      border-radius: var(--radius-l);
      background-color: var(--color-neutral-100);
    }

    // The offset block picks up the brand orange from the illustrations, so the
    // feature grid carries the same blue/orange pairing they do.
    &::after {
      z-index: 0;
      inset: var(--space-m) -0.85rem -0.85rem 1rem;
      border-radius: var(--radius-l);
      background-color: var(--color-accent-400);
    }
  }

  .feature :global(.feature-image) {
    // The card paints its background in ::before at z-index 1. Direct children get
    // z-index 2 from the rule above, but this more specific selector would otherwise
    // leave the image on the default layer, hidden behind that background.
    position: relative;
    z-index: 2;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-m);
  }

  :global(.feature [data-icon]) {
    inline-size: 4rem;
    block-size: auto;
    color: var(--link-color);
  }

  :global(.darkmode .feature::before) {
    box-shadow: 0 0 0 6px var(--color-neutral-900);
    background-color: var(--color-neutral-900);
  }
</style>
