---
import ContentImage from '@components/ContentImage.astro'

interface Props {
  heading?: string
  src?: string
  alt?: string
  imageSide?: 'left' | 'right'
}

const { heading, src, alt = '', imageSide = 'left' } = Astro.props
---

<div class:list={['two-column', `image-${imageSide}`]}>
  <div class="text-side">
    {heading && <h2>{heading}</h2>}
    <slot />
  </div>
  <div class="image-side">
    {src && (
      <ContentImage
        class="two-column-image"
        src={src}
        alt={alt}
        widths={[400, 700, 1000]}
        sizes="(min-width: 768px) 45vw, 90vw"
        loading="lazy"
      />
    )}
    <slot name="image" />
  </div>
</div>

<style lang="scss">
  .two-column {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
    align-items: center;
    margin-block-end: var(--space-2xl);

    // Text beside an image needs the page width, not the prose column's reading
    // measure: squeezed into half of 52ch each column is a dozen words wide. Breaks
    // out rightward exactly like CardGrid, so the left edge stays on the headings.
    @media (min-width: 768px) {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      inline-size: min(68rem, 100vw - 2 * var(--grid-gutter));
      max-inline-size: none;
      margin-inline-end: calc(100% - min(68rem, 100vw - 2 * var(--grid-gutter)));
    }
  }

  // Text comes first in the markup so a screen reader reaches the heading before the
  // picture; the grid places the image on the requested side. `direction: rtl` was
  // used here before and flipped the sides, putting every image opposite its prop.
  @media (min-width: 768px) {
    .image-left .image-side {
      grid-column: 1;
      grid-row: 1;
    }

    .image-left .text-side {
      grid-column: 2;
    }
  }

  .text-side {
    // Slotted MDX paragraphs are not direct children of the page's space-content,
    // so they would otherwise run together without a gap.
    > :global(* + *) {
      margin-block-start: var(--space-s);
    }

    h2 {
      margin-block-end: var(--space-s);
      font-size: clamp(1.5rem, 3vw, 2.2rem);
    }
  }

  .image-side {
    :global(.two-column-image) {
      border-radius: var(--radius-m);
      inline-size: 100%;
      block-size: auto;
      object-fit: cover;
    }
  }
</style>
