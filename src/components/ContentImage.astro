---
import { Image } from 'astro:assets'
import { resolveUpload } from '@utils/uploads'

/** Renders a Keystatic image reference through Astro's asset pipeline as WebP plus responsive widths. */
interface Props {
  src?: string | null
  alt: string
  widths: number[]
  sizes: string
  /** Crops the image to this ratio. Omit to keep the file's own proportions. */
  aspect?: string
  loading?: 'eager' | 'lazy'
  class?: string
}

const { src, alt, widths, sizes, aspect, loading = 'lazy', class: className } = Astro.props
const asset = src ? resolveUpload(src) : undefined
---

{
  asset && (
    <Image
      class={className}
      src={asset}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding={loading === 'eager' ? 'sync' : 'async'}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      style={aspect ? `aspect-ratio:${aspect}` : undefined}
      format="webp"
    />
  )
}
