---
import { Icon } from 'astro-icon/components'

interface Props {
  /**
   * The quote content that will be displayed
   */
  children: any
  /**
   * The name of the person who said the quote
   */
  author?: string
  /**
   * Their role or institution, kept separate from the name so it can be
   * translated without touching the name itself.
   */
  role?: string
}

const { author, role } = Astro.props
---

<blockquote class="pl-4">
  <div>
    <Icon aria-hidden="true" name="lucide:quote" size="2rem" />
    <slot />
    <Icon aria-hidden="true" name="lucide:quote" size="2rem" />
  </div>
  {
    author && (
      <cite class="attribution">
        <span class="attribution-name">{author}</span>
        {role && <span class="attribution-role">{role}</span>}
      </cite>
    )
  }
</blockquote>

<style lang="scss" is:global>
  blockquote {
    border-inline-start: 4px solid var(--color-accent-400);
    font-size: var(--font-size-2);

    p {
      display: inline;
    }

    // The quote marks carry the accent; the quoted text stays in body ink so it
    // keeps full contrast.
    svg {
      display: inline;
      margin-block-start: calc(var(--space-s) * -1);
      color: var(--color-accent-400);

      &:first-child {
        scale: -1 1;
      }
    }

    cite {
      display: block;
      margin-block-start: var(--space-s);
      font-size: var(--font-size-1);
    }

    .attribution-name {
      display: block;
      font-weight: 700;
      font-style: normal;
    }

    .attribution-role {
      display: block;
      color: var(--color-neutral-700);
      font-size: var(--font-size--1);
    }
  }
</style>
