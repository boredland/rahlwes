---
import { Link } from 'accessible-astro-components'
import { getNavItems } from '@i18n/nav'
import { currentLocale } from '@i18n/config'
import LanguagePicker from '@components/LanguagePicker.astro'

interface Props {
  /** The list renders twice (desktop and mobile menu), so ids inside it need a prefix. */
  idPrefix: string
}

const { idPrefix } = Astro.props
const locale = currentLocale(Astro.currentLocale)
const items = getNavItems(locale)
const pathname = Astro.url.pathname
---

<ul class="menu">
  {
    items.map((item) => {
      const isActive = pathname === item.href || pathname.startsWith(`${item.href}/`)
      return (
        <li class="menu-item">
          <Link href={item.href} class={isActive ? 'is-active' : undefined} aria-current={isActive ? 'page' : undefined}>
            {item.label}
          </Link>
        </li>
      )
    })
  }
  <li class="menu-item">
    <LanguagePicker id={`${idPrefix}-language-picker-label`} />
  </li>
</ul>
