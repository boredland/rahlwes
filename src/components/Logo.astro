---
import { Link } from 'accessible-astro-components'
import themeConfig from '@theme-config'
import { currentLocale, localizePath } from '@i18n/config'

const locale = currentLocale(Astro.currentLocale)
---

<Link href={localizePath('/', locale)} class="logo">
  <span class="logo-name">{themeConfig.name}</span>
  <span class="logo-claim">{themeConfig.seo.subtitle}</span>
</Link>

<style lang="scss">
  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-decoration: none;
  }

  .logo-name {
    font-size: var(--font-size-1);
    font-weight: 700;
  }

  .logo-claim {
    color: var(--color-primary-400);
    font-size: var(--font-size--1);
    font-style: italic;
  }
</style>
