---
import { Link } from 'accessible-astro-components'
import { currentLocale, localizePath } from '@i18n/config'
import mark from '@assets/logo-mark.svg?raw'

/**
 * The monogram is the traced original (its 21px source vectorises cleanly), but the
 * three text lines are set in live type. In the source bitmap "HISTORIKERIN" and the
 * tagline are only 8px tall with 1px stems — there is no glyph shape left to trace,
 * so tracing them produced visibly melted letterforms. Real text is also selectable,
 * searchable and restyleable.
 *
 * Geometry matches the original: all three lines span the same width, right-aligned
 * to a common edge, with the mark and a hairline rule to their left.
 */
const locale = currentLocale(Astro.currentLocale)
---

<Link href={localizePath('/', locale)} class="logo">
  <span class="logo-mark" set:html={mark} aria-hidden="true" />
  <span class="logo-text">
    <span class="logo-name">Rahlwes</span>
    <span class="logo-role">Historikerin</span>
    <span class="logo-claim">Historical Research Service</span>
  </span>
</Link>

<style lang="scss">
  .logo {
    display: inline-flex;
    align-items: stretch;
    gap: 0.5rem;
    text-decoration: none;
  }

  .logo-mark :global(svg) {
    display: block;
    inline-size: auto;
    block-size: 2.75rem;
    color: var(--link-color);
    transition: color var(--animation-speed-fast) var(--cubic-bezier);
  }

  // Replaces the divider rule that was baked into the original bitmap.
  .logo-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-inline-start: 1px solid color-mix(in srgb, var(--foreground-color) 24%, transparent);
    padding-inline-start: 0.5rem;
    color: var(--foreground-color);
  }

  // The three lines were justified to one common width in the original; letter-spacing
  // is tuned per line to reproduce that without stretching the glyphs.
  .logo-name {
    font-size: 1.32rem;
    font-weight: 700;
    letter-spacing: 0.325em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .logo-role {
    font-size: 0.64rem;
    font-weight: 400;
    letter-spacing: 0.581em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .logo-claim {
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.076em;
    line-height: 1.2;
  }

  .logo:where(:hover, :focus-visible) .logo-mark :global(svg) {
    color: var(--link-hover-color);
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-mark :global(svg) {
      transition: none;
    }
  }
</style>
