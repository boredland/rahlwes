---
import Navigation from '@components/Navigation.astro'
import { SkipLink } from 'accessible-astro-components'
import { currentLocale } from '@i18n/config'
import { useTranslations } from '@i18n/ui'

const t = useTranslations(currentLocale(Astro.currentLocale))
---

<header>
  <SkipLink text={t('skip.content')} />
  <Navigation />
</header>
