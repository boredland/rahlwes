---
import { Heading } from 'accessible-astro-components'

interface Props {
  title: string
  /** Plain text: page subtitles come from Keystatic's plain-text fields. */
  subtitle?: string
}

const { title, subtitle } = Astro.props
---

{/* The empty my-3 row keeps the spacing the breadcrumb slot used to reserve. */}
<section class="page-header">
  <div class="container my-3"></div>
  <div class="space-content container py-16">
    <Heading level="h1">{title}</Heading>
    {subtitle && <p class="text-2xl">{subtitle}</p>}
  </div>
</section>
