---
import ArticlePage from '@layouts/ArticlePage.astro'
import { defaultLocale } from '@i18n/config'
import { getProjects } from '@i18n/content'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const projects = await getProjects(defaultLocale)
  return projects.map((entry) => ({
    params: { slug: entry.id.split('/').slice(1).join('/') },
    props: { entry },
  }))
}

const { entry } = Astro.props as { entry: CollectionEntry<'projects'> }
---

<ArticlePage locale={defaultLocale} entry={entry} />
