---
import UnsubscribePage from '@layouts/UnsubscribePage.astro'
import { defaultLocale, locales, type Locale } from '@i18n/config'

export const prerender = false

const locale = Astro.params.locale as Locale
if (locale === defaultLocale || !locales.includes(locale)) return new Response(null, { status: 404 })
---

<UnsubscribePage locale={locale} />
