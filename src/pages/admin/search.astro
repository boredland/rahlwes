---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import AdminBack from '@components/AdminBack.astro'
import ArchiveSearch from '@components/ArchiveSearch.tsx'
import { selectableSources } from '@ankai/providers'

// Same reason as every other admin page: prerendering would bake the middleware's
// login redirect into a static file that never reaches the guard again.
export const prerender = false

/**
 * The archive search UI. The fan-out itself lives in `src/ankai/` and runs in this
 * worker, so the catalog is read straight from the provider list rather than fetched:
 * one source of truth, and the toggles cannot drift from what the server queries.
 */
const sources = selectableSources
---

<DefaultLayout title="Archivsuche" description="Recherche in Archivbeständen">
  <section class="my-16">
    <div class="container">
      <AdminBack />
      <h1>Archivsuche</h1>
      <p class="subtitle">
        Eine Abfrage über die angebundenen Archivsysteme. Die Ergebnisse sind Findmittel-Metadaten; alles Weitere wird
        direkt zur haltenden Institution verlinkt.
      </p>

      <ArchiveSearch sources={sources} client:load />
    </div>
  </section>
</DefaultLayout>

<style lang="scss" is:global>
  .subtitle {
    color: var(--color-neutral-700);
    font-size: var(--font-size--1);
    margin-block-end: var(--space-l);
    max-inline-size: var(--font-measure);
  }

  .archive {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .archive-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: var(--space-l);
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-m);
  }

  .archive-fields {
    display: grid;
    gap: var(--space-m);

    @media (min-width: 40rem) {
      grid-template-columns: 1fr 1fr;
    }

    label {
      display: block;
    }

    span {
      display: block;
      margin-block-end: var(--space-3xs);
      font-size: var(--font-size--1);
      font-weight: 600;
    }

    input {
      inline-size: 100%;
      padding: var(--space-2xs) var(--space-xs);
      border: 1px solid var(--border-color-subtle);
      border-radius: var(--radius-s);
      background: var(--color-neutral-100);
      color: inherit;
      font: inherit;
      font-size: var(--font-size--1);
    }
  }

  .archive-sources {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .archive-chip {
    padding: var(--space-3xs) var(--space-xs);
    border: 1px solid var(--border-color-subtle);
    border-radius: 999px;
    background: transparent;
    color: var(--color-neutral-700);
    font-size: var(--font-size--2);
    cursor: pointer;

    &.is-on {
      border-color: var(--color-primary-500);
      background: var(--color-primary-500);
      color: var(--color-neutral-100);
    }
  }

  .archive-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--border-color-subtle);
  }

  .archive-check {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--font-size--1);
    color: var(--color-neutral-700);
  }

  .archive-submit {
    padding: var(--space-2xs) var(--space-m);
    border: 0;
    border-radius: var(--radius-s);
    background: var(--color-primary-500);
    color: var(--color-neutral-100);
    font: inherit;
    font-size: var(--font-size--1);
    cursor: pointer;

    &:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  }

  .archive-results {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .archive-status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .archive-pill {
    padding: var(--space-3xs) var(--space-2xs);
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-s);
    font-size: var(--font-size--2);
    color: var(--color-neutral-700);

    &.is-error {
      border-color: #c2554044;
      color: #a33f2c;
    }

    &.is-stale {
      border-color: #b6864f44;
    }
  }

  .archive-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .archive-card {
    padding: var(--space-m);
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-m);

    > a {
      font-weight: 700;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .archive-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-xs);
    margin-block-start: var(--space-3xs);
    font-size: var(--font-size--2);
    color: var(--color-neutral-600);
  }

  .archive-source {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .archive-preview {
    margin-block-start: var(--space-2xs);
    font-size: var(--font-size--1);
    color: var(--color-neutral-700);
  }

  .archive-mark {
    padding-inline: 0.15em;
    border-radius: var(--radius-s);
    background: #f3e6c8;
    color: inherit;
  }

  .archive-more {
    align-self: flex-start;
    padding: var(--space-2xs) var(--space-m);
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-s);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--font-size--1);
    cursor: pointer;
  }

  .archive-linkouts {
    padding: var(--space-m);
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-m);

    h2 {
      margin-block-end: var(--space-2xs);
      font-size: var(--font-size-0);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
      padding: 0;
      margin: 0;
      list-style: none;
    }
  }

  .archive-note {
    margin-inline-start: var(--space-2xs);
    font-size: var(--font-size--2);
    color: var(--color-neutral-600);
  }

  .archive-empty,
  .archive-error {
    font-size: var(--font-size--1);
    color: var(--color-neutral-700);
  }

  .archive-error {
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid #c2554044;
    border-radius: var(--radius-s);
    color: #a33f2c;
  }
</style>
