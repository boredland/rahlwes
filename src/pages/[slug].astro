---
import ArticlePage from '@layouts/ArticlePage.astro'
import { defaultLocale } from '@i18n/config'
import { getLocalized } from '@i18n/content'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const pages = await getLocalized('pages', defaultLocale)
  return pages.map((entry) => ({
    params: { slug: entry.id.split('/').slice(1).join('/') },
    props: { entry },
  }))
}

const { entry } = Astro.props as { entry: CollectionEntry<'pages'> }
---

<ArticlePage locale={defaultLocale} entry={entry} />
