{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rahlwes",
  "compatibility_date": "2026-08-26",
  // `main` and `assets` are intentionally absent: the Astro Cloudflare adapter
  // generates those into dist/server/wrangler.json at build time, and setting them
  // here makes the build fail before dist exists.
  //
  // `remote: true` proxies local dev sends to the real service; without it the
  // binding is a local stub and nothing is delivered.
  //
  // Two bindings, one per sending domain, each restricted to the addresses it may use.
  // Receivers score sender reputation per domain: keeping bulk newsletter mail on
  // marketing.rahlwes.eu means spam complaints there cannot sink the contact-form
  // replies sent from send.rahlwes.eu. The allow-lists make that split enforced by the
  // runtime rather than by whichever constant a call site happens to import.
  "send_email": [
    { "name": "EMAIL", "remote": true, "allowed_sender_addresses": ["kontakt@send.rahlwes.eu"] },
    {
      "name": "NEWSLETTER_EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["newsletter@marketing.rahlwes.eu"]
    }
  ],
  "ratelimits": [
    // Per-IP throttle on the contact endpoint: cheap, credential-free protection that
    // holds even if the Turnstile widget is missing or its script fails to load.
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Newsletter signup carries no captcha, so it gets its own tighter bucket rather
    // than sharing the contact form's allowance.
    { "name": "NEWSLETTER_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "NEWSLETTER_DB",
      "database_name": "rahlwes-newsletter",
      "database_id": "d4f27b52-5ca4-4417-9f6f-50448e5091dd",
      "migrations_dir": "migrations"
    },
    // The archive corpus ankai ingests the Gedenkbuch CSV into. Same database id, so no
    // migration is needed and either worker can ingest during the changeover.
    { "binding": "ANKAI_DB", "database_name": "ankai", "database_id": "c59d1fcf-0fa4-47e6-bab6-c07076bed722" }
  ],
  // One message per subscriber. `max_concurrency` bounds how many sends run at once so
  // a large dispatch cannot outrun the Email Sending rate limit.
  "queues": {
    "producers": [{ "queue": "send-newsletter-queue", "binding": "NEWSLETTER_QUEUE" }],
    "consumers": [{ "queue": "send-newsletter-queue", "max_batch_size": 10, "max_concurrency": 2, "max_retries": 3 }]
  },
  // Ankai's upstream response cache. Same namespace the standalone ankai worker uses, so
  // both serve identical data while it is being retired.
  //
  // Prefixed because a bare `CACHE` would read as this site's own; nothing else here
  // uses KV.
  // Arcinsys and Yad Vashem only answer a real browser session, so those two adapters
  // render their JS search through this proxy. Non-secret; the paired FETCH_PROXY_TOKEN
  // is a Worker secret. Without the token both sources report stale and the rest answer.
  "vars": { "FETCH_PROXY_URL": "https://fetch-proxy.jonas-strassel.de/", "GATEWAY_TIMEOUT_MS": "15000" },

  "kv_namespaces": [{ "binding": "ANKAI_CACHE", "id": "80b6423e83024989a5c29dcb832fd7fa" }],

  // Hard bounces appear on the account suppression list hours after a send, with no
  // webhook to subscribe to, so they are polled once a day.
  "triggers": { "crons": ["17 4 * * *"] },
  // Lets the dispatcher render a newsletter through its own SSR routes. Fetching the
  // public hostname from inside the Worker loops back out through the edge and fails
  // with a 522; a self binding dispatches the request internally instead.
  "services": [{ "binding": "SELF", "service": "rahlwes" }],
  "routes": [{ "pattern": "next.rahlwes.eu", "custom_domain": true }],
  // A hard ceiling on CPU per invocation, well above what any route needs: the archive
  // fan-out ranks ~180 records in about 1 ms and the newsletter consumer does almost
  // nothing between awaits. It exists so a runaway loop or a pathological input fails
  // that one request with Error 1102 instead of quietly billing CPU until someone
  // notices — Workers bills CPU time, so an infinite loop is a bill, not just a hang.
  "limits": { "cpu_ms": 5000 },

  "observability": { "enabled": true }
}
