# DeepL translation and DeepL Write, used by scripts/translate.mjs and scripts/rephrase.mjs
DEEPLX_URL=https://translate.jonas-strassel.de
DEEPLX_TOKEN=

# Keystatic GitHub App, required for the editor at /keystatic.
#
# Create the app by hand at https://github.com/settings/apps/new — the wizard at
# /keystatic/setup cannot finish here, because Keystatic's app-creation callback
# only runs under Node and this site runs on the Cloudflare runtime.
#
#   Homepage URL   https://next.rahlwes.eu/keystatic
#   Callback URLs  https://next.rahlwes.eu/api/keystatic/github/oauth/callback
#                  http://127.0.0.1:4321/api/keystatic/github/oauth/callback
#   Request user authorization (OAuth) during installation: yes
#   Webhook: inactive
#   Repository permissions: Contents read+write, Metadata read, Pull requests read
#
# Then install the app on the content repository.
#
# KEYSTATIC_SECRET encrypts the refresh-token cookie (HKDF-SHA256 + AES-GCM-256)
# and must be at least 32 characters: `openssl rand -hex 40`.
#
# In production these live as Worker secrets rather than in a file — one
# `wrangler secret put <NAME>` per key.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Bounce reconciliation. The newsletter reads Cloudflare's account-wide suppression
# list once a day to find addresses that hard-bounced after a send, because the
# EMAIL binding reports only that a message was accepted, not that it later bounced.
#
# Without these two the newsletter still sends; only bounce detection is inactive,
# and /admin/subscribers reports the reason when the abgleich is triggered by hand.
#
# Create a scoped API token at https://dash.cloudflare.com/profile/api-tokens with
# the single permission: Account > Email Sending > Read. Do NOT reuse a global key —
# this token only ever needs to read a suppression list.
#
# Both live as Worker secrets in production:
#   wrangler secret put CLOUDFLARE_ACCOUNT_ID
#   wrangler secret put CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Shared secret for the daily Ausschreibungen digest.
#
# .github/workflows/scrape-cfps.yml posts what scripts/scrape-cfps.mjs found to
# /api/cfps/notify. That route sits outside /api/admin because a GitHub Action has
# no Keystatic login cookie to present, so this secret is the only thing standing
# between the internet and a mail to the digest list — it is compared in constant
# time and the route refuses every request while it is unset.
#
# Generate with `openssl rand -hex 32`, then store it in both places:
#   wrangler secret put CFP_WEBHOOK_SECRET
#   gh secret set CFP_WEBHOOK_SECRET
CFP_WEBHOOK_SECRET=

# AI proxy for reading calls published only as a PDF.
#
# One OpenAI-compatible endpoint fronting Gemini; the access token is baked into
# the URL path, so there is no separate key. Shared with the museumsufer project —
# copy the value from there rather than minting a new one.
#
# Optional. Without it scripts/scrape-cfps.mjs collects every call exactly as
# before; it simply cannot pull a deadline out of an attached PDF.
#
#   gh variable get AI_PROXY_URL            # museumsufer repo
#   gh secret set AI_PROXY_URL              # for the scrape workflow
AI_PROXY_URL=
